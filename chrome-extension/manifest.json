{
  "manifest_version": 3,
  "name": "拾页 · 晋江连接",
  "version": "0.1.1",
  "description": "将 Chrome 中的晋江登录连接到本机拾页，仅访问晋江站点。",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.jjwxc.net/*",
    "*://*.jjwxc.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "连接拾页"
  }
}
